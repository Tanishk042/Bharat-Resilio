# Resilio TS services (backend-api, mesh-node, chain) – monorepo image.
# Build context is the bharat-resilio npm workspace root.
# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
RUN npm ci --no-audit --no-fund && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
# Centralise compiled services at /app/dist/services/<name>/src/*.js so the
# package.json "start" scripts (node dist/services/<name>/src/cli.js) resolve.
RUN mkdir -p /app/dist && cp -r services/*/dist/services/. /app/dist/
EXPOSE 8080 8101 8102 8201
CMD ["node", "dist/services/backend-api/src/cli.js"]