# ──────────────────────────────────────────────────────────────────────────────
# Resilio deploy environment
#
# TWO DEPLOYMENT MODES
#
#   A) Single-origin (default) – browser talks only to the Next.js host.
#      The rewrites defined in next.config.mjs proxy /backend, /ml, /mesh,
#      /mesh-b, /chain to the backend services on the internal network.
#      Set only the SERVICE_*_URL vars for the Next.js process.
#
#   B) External hosts – set the NEXT_PUBLIC_* vars to absolute URLs and
#      make sure each service enables CORS for your browser origin.
# ──────────────────────────────────────────────────────────────────────────────

# ── Next.js rewrite targets (internal network – used by the Next server) ─────
SERVICE_API_URL=http://127.0.0.1:8080
SERVICE_ML_URL=http://127.0.0.1:8000
SERVICE_MESH_A_URL=http://127.0.0.1:8101
SERVICE_MESH_B_URL=http://127.0.0.1:8102
SERVICE_CHAIN_URL=http://127.0.0.1:8201

# ── Client-side overrides (mode B only – leave empty for mode A) ─────────────
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_ML_URL=
# NEXT_PUBLIC_MESH_URL=
# NEXT_PUBLIC_MESH_B_URL=
# NEXT_PUBLIC_CHAIN_URL=

# ── ML service (FastAPI/uvicorn) ─────────────────────────────────────────────
ML_PORT=8000
CORS_ORIGINS=*

# ── Backend API gateway (node:http) ───────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
DATA_DIR=./data
ML_URL=http://127.0.0.1:8000
MESH_URL=http://127.0.0.1:8101
CHAIN_URL=http://127.0.0.1:8201
CORS_ORIGIN=*

# ── Mesh node(s) ─────────────────────────────────────────────────────────────
# Node A defaults
# MESH_PORT=7100
# API_PORT=8101
# NODE_ID=mesh-a
# HOST=0.0.0.0
# DATA_ROOT=.mesh-data
# SEEDS=127.0.0.1:7101

# Node B (second node)
# MESH_PORT=7101
# API_PORT=8102
# NODE_ID=mesh-b
# SEEDS=127.0.0.1:7100

# ── Blockchain chain node ────────────────────────────────────────────────────
# CHAIN_PORT=9100
# API_PORT=8201
# HOST=0.0.0.0
# VALIDATORS=chain-a
